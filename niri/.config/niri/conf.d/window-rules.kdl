// 窗口规则配置
// 放进overview里的壁纸程序
layer-rule{
    match namespace="awww-daemonoverview"
    place-within-backdrop true
}
// 带缩略图的alt+tab切换窗口功能（但是我设置的是super+tab，更符合逻辑）
recent-windows {
    // 取消//off的注释可以禁用
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        // 缩略图背景内间距
        padding 30
        // 缩略图的背景圆角
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        // scope可以设置显示的窗口是当前工作区的、还是当前显示器的、或者显示全部窗口
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        // grave是波浪键，显示当前应用的所有窗口
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// 以浮动模式打开的软件
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id="wechat" title="^设置$"
    match app-id="media_info"
    match app-id="video2gif"
    match app-id="floating-term"
    match app-id="nm-connection-editor"
    match app-id="niri-quick-switch"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="blueberry.py" title="蓝牙"
    match app-id="blueman-manager"
    match app-id="flameshot"
    match app-id="com.github.hluk.copyq" 
    match app-id="be.alexandervanhee.gradia"
    match app-id="org.pulseaudio.pavucontrol" title="音量控制"
    match app-id="org.gnome.clocks" title="时钟"
    match app-id="fcitx" title="Fcitx5 Input Window"
    match app-id="org.gnome.FileRoller"
    match app-id="thunar" title="文件操作进度"
    match app-id="waypaper"
    match app-id="clipse-gui"
    match title="群聊的聊天记录"
    match title="聊天记录"
    match title="日历"
    match title="重命名"
    match app-id="btrfs-assistant"
    match app-id="mark-shot"
    match title="Steam 设置" 
    match title="另存为"
    match app-id="better_control.py"
    match app-id="niri-hotkey-menu"
    open-floating true
}

//快速终端
window-rule {
    match title="quickterminal"
	open-floating true
	default-floating-position x=20 y=20 relative-to="top"
    default-column-width { fixed 800; }
    default-window-height { fixed 500; }
}
//shorinclip剪贴板TUI 
window-rule{
	match title="shorinclip"
	default-column-width { fixed 1100; }
    default-window-height { fixed 1000; }
    //min-height 800
	open-floating true
	default-floating-position x=0 y=18 relative-to="top"
}
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"librewolf$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"ibus-ui-gtk3$"#
    open-floating true
    open-focused false
    opacity 0.75
}

overview {
    zoom 0.6
    workspace-shadow {
        //off
    }
}


// Example: block out two password managers from screen capture.s
// (This example rule is commented out with a "/-" in front.)
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// ==================== 全局窗口外观（圆角 + 不透明 + 模糊）====================
//
// 这四项必须写在同一条无 match 的 window-rule 里，不要拆成多条：
// NiriMod（图形化配置编辑器）的「全局」设置只认最后一条无 match 的规则
// （window_effects.py:_global_window_rule 用 reversed 取第一条），
// 一旦拆成两条，GUI 里改圆角会写进另一条，界面上显示的值和实际生效的值对不上。
//
// geometry-corner-radius 6 + clip-to-geometry true：所有窗口圆角 6px
// opacity 0.97：让窗口透出 3%，否则窗口完全不透明时模糊被挡在后面看不见
// xray true：只模糊壁纸、算一次后复用，几乎零开销（shorin-niri 的做法）
//
// 需要 niri >= 26.04。低于该版本写了 background-effect 会启动失败。
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    opacity 0.97
    background-effect {
        blur true
        xray true
    }

    // 应用内右键菜单 / 下拉框。这里用 xray false：
    // 菜单背后是应用自己的窗口内容，模糊真实内容才对，xray true 会误取壁纸。
    // opacity 0.92 同样是为了让模糊透出来，菜单自身不透明的话 blur 等于白加。
    popups {
        opacity 0.92
        background-effect {
            blur true
            xray false
        }
    }
}

// 状态栏。bar 永远压在壁纸上方，xray true 效果相同但更省。
layer-rule {
    match namespace="^waybar$"
    background-effect {
        xray true
        blur true
    }
}

// quickshell 卡片式弹窗。圆角 20 = Theme.radiusXL（matugen/templates/quickshell-theme.js）。
// 全部组件的 shadowPadding 都是 0，layer 尺寸等于卡片尺寸，所以圆角裁剪不会切到内容。
// 刻意排除：
//   quickshell-welcome / idle-warning —— 四边 anchors 全屏，加圆角会切掉屏幕四角并糊整屏
//   各种 -bg 全屏捕获层 —— 同上
layer-rule {
    match namespace="^(quickshell-(bt|volume|recorder|media|screenshot-toolbox|clipboard|launcher|wifi|calendar|weather)|qs-(window-switcher|close-confirm|qr-viewer|wallpaper-selector|power-menu|color-viewer|todo|notifications|notification-popup))$"
    geometry-corner-radius 20
    background-effect {
        xray false
        blur true
    }
}


