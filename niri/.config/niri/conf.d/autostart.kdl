// 启动程序配置
// 加载 XWayland DPI，解决xwayland下fcitx5界面太小
spawn-sh-at-startup "echo 'Xft.dpi: 144' | xrdb -merge"
// 桌面壁纸的守护进程
spawn-at-startup "awww-daemon"
// 总览界面背景壁纸的守护进程
spawn-at-startup "awww-daemon" "-n" "overview"
// 壁纸：是否「自动随机换」由 ~/.cache/wallpaper-auto-rotate 这个开关决定
//   on  → 随机换一张：换图 + matugen 重算全套配色 + 重算总览模糊
//   off → 把上次那张贴回屏幕，不换图、不换色、不重算模糊，开机零计算
// 切换开关：Mod+Ctrl+F10，或手动跑 ~/.config/scripts/wallpaper-rotate.sh toggle
// ⚠️ 别改回 waypaper --restore：它同样会跑 config.ini 里的 post_command
//    （matugen + niri_auto_blur_bg.sh），等于照样「动」，开关就白做了。
spawn-sh-at-startup "sleep 1 && ~/.config/scripts/wallpaper-rotate.sh boot"
// 询问管理员权限功能（身份验证）
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// 有聚焦窗口时桌面自动模糊的脚本，因为niri的wip/branch测试分支支持了窗口模糊，所以这一项不再必要。使用niri-blur-toggle即可切换为窗口模式的测试分支。
spawn-at-startup "~/.config/scripts/niri_auto_blur_bg.sh"
// 屏幕分享、录屏相关的环境设置,如果屏幕分享出异常的话可以开启
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gnome"
// GNOME tracker修复
// spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
// 通知程序
// spawn-at-startup "mako"
// 开机固定是 main 样式：swaync + 裸 waybar。
// 切到 Quickshell 样式（Mod+F4）时由 ~/.config/scripts/switch-waybar.sh
// 关掉 swaync、拉起 qs-notifications.service；切回时反向操作。
spawn-at-startup "swaync"
// 任务栏
spawn-at-startup "waybar"
// 输入法
spawn-at-startup "fcitx5" 
// 剪贴板守护进程
// 只留下面那行拆分 text / image 的版本：两条都开会让每次复制在 cliphist 里
// 存 3 份，剪贴板面板里出现重复条目（Quickshell 的 clipboard 读同一个库，也会重复）
// spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
// 使用rofi剪贴板
spawn-sh-at-startup "wl-paste --type text --watch cliphist store & wl-paste --type image --watch cliphist store & wait"
// spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
// 空闲策略：180s 锁屏 / 300s 熄屏 / 600s 自动挂起 / 合盖前立刻锁屏（时间线见 niri/scripts/swayidle.sh）
spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
// 大写锁定键的osd显示
spawn-at-startup "swayosd-server"
// osd依赖，有些电脑会自动启动，看情况开启
spawn-sh-at-startup "sleep 2 && pkexec swayosd-libinput-backend"
// 自动开启护眼模式,经纬度设置位置
// spawn-at-startup "~/.local/bin/toggle-wlsunset"
// niri-siderbar
// spawn-at-startup "~/.local/bin/niri-sidebar" "listen"
// 允许 root 通过用户的 XWayland 打开窗口。
// 已停用，原因有两条：
//   1. niri 的 XWayland 是懒启动的 —— 第一次有 X 客户端连进来才起来，autostart
//      阶段 DISPLAY 还没设置，这行必然报 "xhost: unable to open display"，
//      每次登录刷一条失败。
//   2. 本配置没有任何需要 root 权限的 X11 GUI 程序。唯一用 pkexec 的是
//      swayosd-libinput-backend，那是 Wayland 原生程序，跟 xhost 无关。
// 真要跑 gparted / 类似工具时：pacman -S xorg-xhost，再取消下面这行注释。
// spawn-at-startup "xhost" "+si:localuser:root"


// 系统基础服务
// spawn-at-startup "sh" "-c" "systemctl --user set-environment XDG_CURRENT_DESKTOP=wlroots"
// spawn-at-startup "xwayland-satellite"
// 桌面门户
// spawn-at-startup "systemctl" "--user" "restart" "xdg-desktop-portal"
// spawn-at-startup "xdg-desktop-portal-wlr"

hotkey-overlay {
    skip-at-startup
}

