# 临时文件
*.log
*.tmp
# 安装器进度记录
.install_progress
config_backup_*.tar.gz
# 依赖目录
node_modules/
__pycache__/
# Quickshell 的 uv 虚拟环境（cd ~/.config/quickshell && uv sync 生成）
quickshell/.config/quickshell/.venv
# 系统隐藏文件
.DS_Store
.idea/
# 编译产物
dist/
build/


# 忽略文件
btop/.config/btop/themes/matugen.theme
fastfetch/.config/fastfetch/config.jsonc
fcitx5/.config/fcitx5/conf/cached_layouts
fcitx5/.config/fcitx5/conf/classicui
fcitx5/.config/fcitx5/conf/notifications.conf
fcitx5/.config/fcitx5/profile
fuzzel/.config/fuzzel/colors.ini
kitty/.config/kitty/current-theme.conf
kitty/.config/kitty/kitty.conf
kitty/.config/kitty/kitty.conf.bak
kitty/.config/kitty/themes/
local-share-fcitx5/.local/share/fcitx5/rime/installation.yaml
local-share-fcitx5/.local/share/fcitx5/rime/rime_ice.userdb/
local-share-fcitx5/.local/share/fcitx5/rime/sync
local-share-fcitx5/.local/share/fcitx5/rime/user.yaml
local-share-fcitx5/.local/share/fcitx5/themes/
mako/.config/mako/colors.conf
# Anime4K 着色器由 04-apps.sh 下载到 ~/.config/mpv/shaders（mpv 包是折叠软链，会直接写进仓库）
mpv/.config/mpv/shaders/
# 开启 save-position-on-quit 后 mpv 在这里写播放进度
mpv/.config/mpv/watch_later/
.marscode/
# NiriMod 写入残留的临时文件（正常情况会自己清理，被 kill 时会留下）
niri/.config/niri/.nirimod_tmp_*
# matugen 生成的边框色，NiriMod 每次保存都会重新序列化它
niri/.config/niri/conf.d/colors.kdl
# NiriMod 的配置快照（跟随 niri 配置目录，会落在仓库里）
niri/.config/niri/profiles/
niri/.config/niri/scripts/venv
obs-studio/.config/obs-studio/matugen.obt
obs-studio/.config/obs-studio/themes/
Thunar/.config/Thunar/accels.scm
wallpaper/Pictures/Wallpapers/api-random-download/
wallpaper/Pictures/Wallpapers/cache-niri-auto-blur-bg
wallpaper/Pictures/Wallpapers/cache-niri-overview-blur-dark
wallpaper/Pictures/Wallpapers/wallpapers
waybar-niri-Win11Like/.config/waybar-niri-Win11Like/colors.css
waybar-quickshell/.config/waybar-quickshell/colors.css
quickshell/.config/quickshell/Commons/Theme.js
# 组件目录里由 qs-popup / 安装器自动生成的副本：
# QML 的 JS 脚本导入不能用 ../，每个组件目录都要有自己的一份 ./Theme.js
quickshell/.config/quickshell/*/Theme.js
quickshell/.config/quickshell/*/ScreenModel.js
# Commons/ScreenModel.js 是源文件（不是生成物），必须提交
!quickshell/.config/quickshell/Commons/ScreenModel.js
yazi/.config/yazi/theme.toml
gtk-3.0/.config/gtk-3.0/colors.css
gtk-3.0/.config/gtk-3.0/gtk.css
# GTK 书签由 setup 按当前 $HOME 生成（内容因人而异，不能提交）
gtk-3.0/.config/gtk-3.0/bookmarks
local-share-applications/.local/share/applications/mimeapps.list
local-share-applications/.local/share/applications/mimeinfo.cache
obs-studio/.config/obs-studio/logs/2026-03-27 14-56-03.txt
obs-studio/.config/obs-studio/profiler_data/2026-03-27 14-56-03.csv.gz
zsh/.config/zsh/.zcompdump-PullautumnArch-5.9
zsh/.config/zsh/.zcompdump-PullautumnArch-5.9.zwc
zsh/.config/zsh/.zcompdump

