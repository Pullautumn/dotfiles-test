# ============================================================
# 换行符策略：全部使用 LF（Linux 换行）
# ============================================================
# 本仓库是 Linux 桌面（niri + waybar + quickshell）的 dotfiles，
# 所有脚本/配置在 Linux 上运行。Windows 上的 core.autocrlf=true
# 会把检出改成 CRLF，导致 bash 报 "$'\r': command not found"，
# 并让 QML/JSONC/KDL 的 diff 出现整文件变动。
#
# 这里显式钉死：仓库内存 LF，检出也必须是 LF，不受
# core.autocrlf 影响。

* text=auto eol=lf

# ------------------------------------------------------------
# 明确按文本处理（即使内容看起来像二进制也不转换）
# ------------------------------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.qml       text eol=lf
*.kdl       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.toml      text eol=lf
*.css       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.md        text eol=lf
*.desktop   text eol=lf
*.svg       text eol=lf
qmldir      text eol=lf

# ------------------------------------------------------------
# 二进制：禁止任何换行/内容转换
# ------------------------------------------------------------
*.png       binary
# fastfetch 的 .icon 名字像文本，实际是 PNG 容器，必须按二进制处理
*.icon      binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.mp3       binary
*.ogg       binary
*.flac      binary
*.wav       binary
*.mp4       binary
*.webm      binary
*.mkv       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.xz       binary
*.zst       binary
*.7z        binary
*.so        binary
*.pyc       binary
*.db        binary
*.sqlite    binary
